generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model farmers {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmer_code   String         @unique @db.VarChar(30)
  first_name    String         @db.VarChar(100)
  last_name     String         @db.VarChar(100)
  middle_name   String?        @db.VarChar(100)
  phone         String?        @db.VarChar(30)
  address       String?
  farm_location String?
  status        String         @default("ACTIVE") @db.VarChar(20)
  created_by    String         @db.Uuid
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @db.Timestamptz(6)
  users         users          @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "farmers_created_by_fk")
  payments      payments[]
  transactions  transactions[]

  @@index([status], map: "idx_farmers_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_items {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku           String         @unique @db.VarChar(50)
  name          String         @db.VarChar(150)
  category      String         @db.VarChar(50)
  description   String?
  unit          String         @db.VarChar(30)
  quantity      Decimal        @default(0) @db.Decimal(12, 2)
  unit_cost     Decimal        @default(0) @db.Decimal(12, 2)
  reorder_level Decimal        @default(0) @db.Decimal(12, 2)
  status        String         @default("IN_STOCK") @db.VarChar(20)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @db.Timestamptz(6)
  transactions  transactions[]

  @@index([category], map: "idx_inventory_category")
  @@index([status], map: "idx_inventory_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_code     String       @unique @db.VarChar(30)
  farmer_id        String       @db.Uuid
  transaction_id   String       @db.Uuid
  amount           Decimal      @db.Decimal(12, 2)
  payment_method   String       @db.VarChar(30)
  reference_number String?      @db.VarChar(100)
  notes            String?
  payment_date     DateTime     @default(now()) @db.Timestamptz(6)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  farmers          farmers      @relation(fields: [farmer_id], references: [id], onUpdate: NoAction, map: "payments_farmer_fk")
  transactions     transactions @relation(fields: [transaction_id], references: [id], onUpdate: NoAction, map: "payments_transaction_fk")

  @@index([payment_date], map: "idx_payments_date")
  @@index([farmer_id], map: "idx_payments_farmer_id")
  @@index([transaction_id], map: "idx_payments_transaction_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_code  String           @unique @db.VarChar(30)
  farmer_id         String           @db.Uuid
  inventory_item_id String?          @db.Uuid
  type              String           @db.VarChar(30)
  description       String?
  quantity          Decimal?         @db.Decimal(12, 2)
  unit_price        Decimal?         @db.Decimal(12, 2)
  amount            Decimal          @db.Decimal(12, 2)
  paid_amount       Decimal          @default(0) @db.Decimal(12, 2)
  balance           Decimal          @db.Decimal(12, 2)
  status            String           @default("UNPAID") @db.VarChar(20)
  transaction_date  DateTime         @default(now()) @db.Timestamptz(6)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @default(now()) @db.Timestamptz(6)
  payments          payments[]
  farmers           farmers          @relation(fields: [farmer_id], references: [id], onUpdate: NoAction, map: "transactions_farmer_fk")
  inventory_items   inventory_items? @relation(fields: [inventory_item_id], references: [id], onUpdate: NoAction, map: "transactions_inventory_fk")

  @@index([transaction_date], map: "idx_transactions_date")
  @@index([farmer_id], map: "idx_transactions_farmer_id")
  @@index([status], map: "idx_transactions_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebase_uid  String?   @unique @db.VarChar(128)
  email         String    @unique @db.VarChar(255)
  password_hash String?   @db.VarChar(255)
  full_name     String    @db.VarChar(150)
  phone         String?   @db.VarChar(30)
  role          String    @default("OWNER") @db.VarChar(20)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  farmers       farmers[]
}

model settings {
  id                  String   @id @default("default_settings") @db.VarChar(50)
  business_name       String?  @db.VarChar(150)
  registration_number String?  @db.VarChar(100)
  address             String?
  email               String?  @db.VarChar(255)
  phone               String?  @db.VarChar(50)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
}
